{
  "type": "VStack",
  "properties": {
    "spacing": 10,
    "alignment": "leading",
    "padding": "default",
    "frame": { "minWidth": 420, "idealWidth": 460, "maxWidth": 560, "minHeight": 320, "idealHeight": 420, "maxHeight": 640 }
  },
  "children": [
    {
      "type": "HStack",
      "properties": { "spacing": 8, "alignment": "center", "frame": { "maxWidth": "infinity" } },
      "children": [
        {
          "type": "Text",
          "id": 100,
          "properties": { "text": "Reading the boxes...", "font": "subheadline", "foregroundStyle": "secondary" }
        },
        { "type": "Spacer" },
        {
          "type": "Button",
          "id": 120,
          "properties": {
            "systemImage": "arrow.clockwise",
            "buttonStyle": "borderless",
            "help": "Read the boxes again",
            "actionID": "aichat.boxes.refresh"
          }
        }
      ]
    },
    {
      "type": "List",
      "id": 300,
      "properties": {
        "actionID": "aichat.boxes.box.selection.changed",
        "listStyle": "inset",
        "frame": { "maxWidth": "infinity", "maxHeight": "infinity" }
      },
      "template": {
        "type": "HStack",
        "properties": { "spacing": 10, "alignment": "center", "padding": 4 },
        "children": [
          {
            "type": "Image",
            "properties": { "systemName": "$2", "font": "title2", "foregroundStyle": "$4" }
          },
          {
            "type": "VStack",
            "properties": { "alignment": "leading", "spacing": 2 },
            "children": [
              { "type": "Text", "properties": { "text": "$1", "font": "headline" } },
              { "type": "Text", "properties": { "text": "$3", "font": "caption", "foregroundStyle": "secondary" } }
            ]
          }
        ]
      }
    },
    {
      "type": "HStack",
      "properties": { "spacing": 8, "alignment": "center", "frame": { "maxWidth": "infinity" } },
      "children": [
        {
          "type": "Button",
          "id": 130,
          "properties": {
            "title": "Open AgentVM",
            "help": "Make, change and delete boxes and images in the AgentVM app",
            "actionID": "aichat.boxes.agentvm.open"
          }
        },
        { "type": "Spacer" },
        {
          "type": "Button",
          "id": 553,
          "properties": {
            "title": "View",
            "disabled": true,
            "help": "Show the screen of the selected box",
            "actionID": "aichat.boxes.box.view"
          }
        },
        {
          "type": "Button",
          "id": 552,
          "properties": {
            "title": "Stop",
            "disabled": true,
            "help": "Shut the selected box down",
            "actionID": "aichat.boxes.box.stop"
          }
        },
        {
          "type": "Button",
          "id": 551,
          "properties": {
            "title": "Start",
            "disabled": true,
            "help": "Start the selected box; it stops when Cadabra quits",
            "actionID": "aichat.boxes.box.start"
          }
        }
      ]
    }
  ]
}
