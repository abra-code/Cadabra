{
  "type": "VStack",
  "properties": {
    "spacing": 12,
    "alignment": "leading",
    "padding": "default",
    "frame": { "width": 760, "height": 460 }
  },
  "children": [
    {
      "type": "HStack",
      "children": [
        {
          "type": "Text",
          "properties": { "text": "Sandbox Packs", "font": "headline" }
        },
        { "type": "Spacer" },
        {
          "type": "Button",
          "id": 605,
          "properties": {
            "systemImage": "questionmark.circle",
            "imageScale": "medium",
            "buttonStyle": "plain",
            "help": "About sandbox packs",
            "actionID": "aichat.packs.help"
          }
        }
      ]
    },
    {
      "type": "Text",
      "id": 606,
      "properties": {
        "text": "A pack is a set of folders for one kind of work. Tick the packs whose folders the tools on this Mac may use. Select a pack to see what it holds; nothing changes until you click Use These Packs.",
        "foregroundStyle": "secondary",
        "font": "callout",
        "frame": { "maxWidth": "infinity", "alignment": "leading" }
      }
    },
    {
      "type": "HStack",
      "properties": {
        "spacing": 12,
        "alignment": "top",
        "frame": { "maxWidth": "infinity", "maxHeight": "infinity" }
      },
      "children": [
        {
          "type": "Table",
          "id": 600,
          "properties": {
            "columns": ["", "Pack"],
            "columnTypes": [
              {
                "viewType": "Button",
                "dataInterpretation": "systemName",
                "actionContext": "rowIndex",
                "actionID": "aichat.mcp.servers.packs.toggle"
              },
              { "viewType": "Text" }
            ],
            "widths": [28, 240],
            "minWidths": [28, 160],
            "actionID": "aichat.mcp.servers.packs.selection.changed",
            "frame": { "minWidth": 290, "maxWidth": 290, "maxHeight": "infinity" }
          }
        },
        {
          "type": "ScrollView",
          "properties": {
            "frame": { "maxWidth": "infinity", "maxHeight": "infinity", "alignment": "topLeading" }
          },
          "content": {
            "type": "RichText",
            "id": 601,
            "properties": {
              "markdown": "",
              "remoteImages": "never",
              "frame": { "maxWidth": "infinity", "alignment": "leading" }
            }
          }
        }
      ]
    },
    {
      "type": "HStack",
      "children": [
        {
          "type": "Button",
          "id": 607,
          "properties": {
            "title": "Reveal User Packs",
            "actionID": "aichat.mcp.servers.packs.reveal",
            "help": "Show the folder of the packs you saved in the Finder. Each pack is one file; delete a file to remove its pack."
          }
        },
        {
          "type": "Button",
          "id": 604,
          "properties": {
            "title": "Record a Pack...",
            "actionID": "aichat.mcp.servers.packs.record",
            "help": "Make a pack of your own by running a command and recording the folders it needs, on top of the packs ticked here if you like. Closes this sheet without changing the chosen packs."
          }
        },
        { "type": "Spacer" },
        {
          "type": "Button",
          "id": 602,
          "properties": {
            "title": "Cancel",
            "buttonStyle": "bordered",
            "keyboardShortcut": { "key": "escape" },
            "actionID": "aichat.mcp.servers.packs.cancel"
          }
        },
        {
          "type": "Button",
          "id": 603,
          "properties": {
            "title": "Use These Packs",
            "buttonStyle": "borderedProminent",
            "keyboardShortcut": { "key": "return" },
            "actionID": "aichat.mcp.servers.packs.use"
          }
        }
      ]
    }
  ]
}
