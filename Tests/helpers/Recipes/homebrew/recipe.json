{
  "version": 1,
  "description": "Homebrew",
  "steps": [
    {
      "name": "Homebrew folder, owned by the box user",
      "user": "root",
      "run": "mkdir -p /opt/homebrew && chown -R \"$AGENT_VM_BOX_USER\":admin /opt/homebrew"
    },
    {
      "name": "Homebrew",
      "run": "set -o pipefail; curl -fsSL https://github.com/Homebrew/brew/tarball/HEAD | tar xz --strip-components 1 -C /opt/homebrew && /opt/homebrew/bin/brew update --force --quiet",
      "env": { "HOMEBREW_NO_ANALYTICS": "1" }
    },
    {
      "name": "Homebrew in login shells",
      "copy": "files/zprofile",
      "to": "~/.zprofile"
    }
  ],
  "update": [
    {
      "name": "Homebrew, and everything installed with it",
      "run": "/opt/homebrew/bin/brew update --quiet && /opt/homebrew/bin/brew upgrade && /opt/homebrew/bin/brew cleanup --prune=all -s",
      "env": { "HOMEBREW_NO_ANALYTICS": "1", "HOMEBREW_NO_ENV_HINTS": "1" },
      "timeoutSeconds": 3600
    }
  ],
  "checks": ["brew --version"]
}
